<?xml version="1.0" encoding="utf-8"?>
<!-- Navy from the status bar down: no title bar (the top bar shows who you are talking to) -->
<resources>
    <style name="Henchline" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:colorAccent">@color/cyan</item>
    </style>
</resources>
