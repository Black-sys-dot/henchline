<?xml version="1.0" encoding="utf-8"?>
<!-- An agent's bubble: round, its corner by the agent's face small (a messaging app's tail), a hairline edge so it
     stands off the navy (shadows don't show on dark) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface" />
    <stroke android:width="1dp" android:color="#1AFFFFFF" />
    <corners android:bottomLeftRadius="4dp" android:bottomRightRadius="18dp" android:topLeftRadius="18dp"
        android:topRightRadius="18dp" />
</shape>
